# Plantilla de ~/parcheu/.env en el homeserver. desplegar.sh lo crea la primera vez con contraseñas
# aleatorias (chmod 600) y nunca lo sobrescribe. Sin secretos aquí.

# dev = Firebase real + llave de Google (README; el valor por defecto). local = autenticación Fake (cualquier
# `fake-<uid>` entra como ese usuario), IA falsa, sin Google: solo para pruebas con curl y además exige
# ALLOW_FAKE_AUTH=true; sin ella la API y la migración no arrancan. No lo uses con datos de testers.
PARCHEU_ENV=dev
# ALLOW_FAKE_AUTH=true
# Opt-in (E8.5, solo con local): con true, el token fake-admin modera y lee todos los reportes. No lo actives en el homeserver.
# LOCAL_FAKE_ADMIN=false
POSTGRES_PASSWORD=cambiame
HMAC_ANON_KEY=cambiame
# Cola de tareas y jobs en el proceso de la API (ADR-0033). No lo cambies a cloud/fake en el homeserver.
TASKS_MODE=inline
# Los fija desplegar.sh en cada despliegue (SHA de la imagen actual y de la anterior, para revertir).
# PARCHEU_TAG=
# PARCHEU_PREV_TAG=
# Dirección donde se publica el 8090: solo loopback; desde fuera se entra por NPM (README). Ya no hay puerto en la LAN.
# PARCHEU_BIND_LOCAL=127.0.0.1:8090

# --- Con PARCHEU_ENV=dev y ~/parcheu/secrets/sa.json (README, «Activar el modo») ---
FIREBASE_PROJECT_ID=parcheu-dev
AI_VERTEX_PROJECT=parcheu-dev
AI_PROVIDER=
AI_DAILY_BUDGET_USD=
# Opcionales (vacías = valores por defecto): modelos de IA, banderas y uso justo de Plus. Solo llegan a la API
# las variables que compose.yaml lista; si agregas otra, añádela también allí.
# AI_MODEL_CHAT=
# AI_MODEL_JUDGE=
# AI_MODEL_LITE=
# DEMO_USERS_ENABLED=false
# SCENARIO_MODE_ENABLED=
# MODERATION_ENABLED=
# QUOTA_PLUS_DAILY_SIMULATIONS=
# QUOTA_PLUS_DAILY_RANDOM_MATCHES=
# QUOTA_PLUS_DAILY_FULL_REPORTS=
# La API exige una audiencia https y un correo de cuenta de servicio en dev; con TASKS_MODE=inline no se usan
# para llamar a nadie (solo validan el token OIDC de las rutas /internal).
INTERNAL_OIDC_AUDIENCE=https://api-parcheu.homeserverlab.site
TASKS_SERVICE_ACCOUNT=sa-homelab@parcheu-dev.iam.gserviceaccount.com
