# ktlint (spotless) lee este archivo para android/. root=true: no hereda del .editorconfig de la raíz.
# Debe coincidir con editorConfigOverride de android/build.gradle.kts para no reformatear el código.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable
max_line_length = 100
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false

[*.{xml,toml,json,yml,yaml}]
indent_size = 2
