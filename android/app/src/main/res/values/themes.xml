<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema base de la ventana: fondo Tinta (#14111F) para que no haya destello claro antes de Compose. -->
    <style name="Theme.ParcheU" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/parcheu_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Tema de arranque (core-splashscreen): A1 del sistema; installSplashScreen() pasa a Theme.ParcheU. -->
    <style name="Theme.ParcheU.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/parcheu_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.ParcheU</item>
    </style>
</resources>
