<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad y transferencia de Android 12 o posterior. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- El último grafo contiene aristas de Pareja de la persona: no sale del teléfono. -->
        <exclude domain="file" path="datastore/parche.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/parche.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
