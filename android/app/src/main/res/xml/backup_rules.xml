<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de respaldo para API 30 o inferior (`fullBackupContent`). La app guarda la sesión de Firebase Auth
   (refresh token en SharedPreferences sin cifrar) y datos de Pareja: no se respalda nada. Defensa en
   profundidad: `allowBackup` ya está en false (revisión de la ola 6).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
